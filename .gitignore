# Place files (built by Rojo or saved from Studio)
# Studio owns maps, models and UI; Roblox keeps their version history once published.
*.rbxl
*.rbxlx
*.rbxm
*.rbxmx

# Roblox Studio lock files
*.rbxl.lock
*.rbxlx.lock

# Generated by tools
sourcemap.json
roblox.yml

# Wally packages (reinstalled with `wally install`)
Packages/
ServerPackages/
DevPackages/

# Secrets (API keys, webhook URLs)
.env
.env.*

# VS Code: keep shared project settings, ignore personal ones
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json

# OS files
.DS_Store
Thumbs.db
desktop.ini

# Logs and temporary files
*.log
*.tmp
